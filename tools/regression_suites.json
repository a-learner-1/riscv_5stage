{
  "schema_version": 1,
  "description": "仅复用现有 ModelSim RTL 自检入口；每个 case 独立进程。all 包含全部清单组。缺镜像、报告或前置契约不符为 BLOCKED，不自动构建，不执行 PDS、网表或下载。CoreMark formal-short 的 FORMAL FAIL 是预期负测，仍须完整 TB PASS。",
  "groups": [
    {
      "id": "baseline",
      "title": "原 CPU 通路与默认关闭兼容性",
      "cases": [
        "baseline-affected"
      ]
    },
    {
      "id": "cache",
      "title": "指令／数据 Cache 协议、故障与固件仿真",
      "cases": [
        "icache",
        "dcache"
      ]
    },
    {
      "id": "btb",
      "title": "BTB 单元与 CPU 预测恢复",
      "cases": [
        "btb-directed"
      ]
    },
    {
      "id": "irq",
      "title": "定时器与外部／软件中断定向自检",
      "cases": [
        "timer-irq",
        "machine-irq"
      ]
    },
    {
      "id": "coremark",
      "title": "旧移植层与 AXI 三配置短程对照",
      "cases": [
        "coremark-prepare",
        "coremark-axi-short"
      ]
    },
    {
      "id": "board",
      "title": "可选三源中断板顶 RTL 仿真（不下载硬件）",
      "cases": [
        "machine-irq-board"
      ]
    },
    {
      "id": "cycle-profile",
      "title": "CPU 六类周期统计定向自检",
      "cases": [
        "cpu-cycle-profile"
      ]
    },
    {
      "id": "coremark-axi-profile",
      "title": "AXI 统计与六种真实 C 周期分类短程验证",
      "cases": [
        "coremark-axi-short"
      ]
    },
    {
      "id": "axi-latency",
      "title": "AXI 低延迟、公开握手及精确错误恢复",
      "cases": [
        "axi-latency-directed"
      ]
    },
    {
      "id": "axi-write-profile",
      "title": "AXI 写通路分段计时与既有错误／复位恢复",
      "cases": [
        "axi-write-profile-directed",
        "axi-latency-directed"
      ]
    }
  ],
